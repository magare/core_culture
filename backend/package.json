{
  "name": "core-culture-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "setup:local": "tsx scripts/setup-local.ts",
    "user:role": "tsx scripts/set-role.ts",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:integration": "tsx scripts/test-integration.ts",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.5",
    "better-auth": "1.7.5",
    "dotenv": "18.0.2",
    "drizzle-orm": "0.45.3",
    "next": "16.3.5",
    "nodemailer": "10.0.10",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "overrides": { "@esbuild-kit/core-utils": { "esbuild": "0.25.12" } }
}
