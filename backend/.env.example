# Copy to .env.local and supply your own credentials. Never commit .env.local.
DATABASE_URL=postgresql://core_culture:replace-me@127.0.0.1:5432/core_culture_dev
BETTER_AUTH_URL=http://127.0.0.1:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Local mail goes to private .local/mail/*.json files, never to real addresses.
# Non-loopback deployments REQUIRE SMTP, HTTPS and real secrets.
MAIL_MODE=outbox
MAIL_FROM=Core Culture <no-reply@example.com>
# SMTP_URL=smtps://user:password@smtp.example.com:465

# Your reverse proxy MUST overwrite this header and block direct origin access.
TRUSTED_IP_HEADER=x-real-ip
