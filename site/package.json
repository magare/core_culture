{
  "name": "core-culture-site",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "build:motion": "esbuild js/motion.source.js --bundle --format=iife --minify --target=es2022 --outfile=js/motion.js",
    "build:viewer": "esbuild js/model-viewer.js --bundle --format=esm --minify --target=es2022 --legal-comments=linked --outfile=js/model-viewer.bundle.js",
    "build": "npm run build:motion && npm run build:viewer"
  },
  "dependencies": {
    "@phosphor-icons/web": "^2.1.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "three": "0.186.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "gltf-validator": "2.0.0-dev.3.10"
  }
}
